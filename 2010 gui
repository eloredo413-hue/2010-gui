local function measureText(text)
	local success, result = pcall(function()
		return TextService:GetTextSize(
			text,
			FONT_SIZE,
			Enum.Font.Arial,
			Vector2.new(MAX_TEXT_WIDTH, 1000)
		)
	end)

	if success then
		return result
	end

	return Vector2.new(75, 26)
end

local function wrapText(text)
	local words = string.split(text, " ")
	local lines = {}
	local current = ""

	for _, word in ipairs(words) do
		local attempt
		if current == "" then
			attempt = word
		else
			attempt = current .. " " .. word
		end

		local size = measureText(attempt)

		if size.X > MAX_TEXT_WIDTH and current ~= "" then
			table.insert(lines, current)
			current = word
		else
			current = attempt
		end
	end

	if current ~= "" then
		table.insert(lines, current)
	end

	return table.concat(lines, "\n")
end

local function getAnchor(head)
	local attachment = head:FindFirstChild("Retro2009BubbleAnchor")

