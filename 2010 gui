	textFallback.Name = "TextFallback"
	textFallback.Size = UDim2.new(1, 0, 1, 0)
	textFallback.BackgroundTransparency = 1
	textFallback.TextColor3 = Color3.fromRGB(255, 255, 255)
	textFallback.Font = Enum.Font.Arial
